      "@grpc/grpc-js": ">=1.14.4",
      "form-data": ">=4.0.6",
      "launch-editor": ">=2.14.1",
      "@babel/core": ">=7.29.6 <8.0.0",
      "nodemailer": ">=9.1.1 <10.0.0",
      "js-yaml@^4": "^4.3.2",
      "js-yaml@^3": "^3.15.2",
      "websocket-driver": ">=0.7.5",
