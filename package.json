{
  "name": "wfa-monorepo",
  "version": "1.0.0",
  "description": "Too Fresh To Waste — food waste reduction marketplace monorepo",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.17.0"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "pnpm build:deps",
    "build:deps": "pnpm --filter @foodwaste/shared build",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "clean": "turbo run clean && pnpm store prune",
    "backend": "pnpm --filter @foodwaste/backend",
    "mobile": "pnpm --filter @foodwaste/mobile",
    "shared": "pnpm --filter @foodwaste/shared",
    "web": "pnpm --filter @foodwaste/web",
    "web:dev": "pnpm --filter @foodwaste/web dev",
    "web:build": "pnpm --filter @foodwaste/web build",
    "web:start": "pnpm --filter @foodwaste/web start",
    "web:lint": "pnpm --filter @foodwaste/web lint",
    "web:type-check": "pnpm --filter @foodwaste/web type-check",
    "backend:dev": "pnpm --filter @foodwaste/backend dev",
    "backend:build": "pnpm --filter @foodwaste/backend build",
    "backend:start": "pnpm --filter @foodwaste/backend start:prod",
    "// ENTERPRISE TURBO MOBILE COMMANDS": "",
    "mobile:dev": "pnpm turbo run dev --filter=@foodwaste/mobile",
    "mobile:build": "pnpm turbo run build --filter=@foodwaste/mobile",
    "mobile:android": "pnpm turbo run dev:android --filter=@foodwaste/mobile",
    "mobile:ios": "pnpm turbo run dev:ios --filter=@foodwaste/mobile",
    "mobile:metro": "pnpm turbo run metro --filter=@foodwaste/mobile",
    "mobile:test": "pnpm turbo run test --filter=@foodwaste/mobile",
    "mobile:lint": "pnpm turbo run lint --filter=@foodwaste/mobile",
    "mobile:clean": "pnpm turbo run clean --filter=@foodwaste/mobile",
    "// ENTERPRISE DIRECT COMMANDS (CI/CD)": "",
    "dev:android": "cd apps/mobile/android && ./gradlew assembleDebug",
    "dev:android:clean": "cd apps/mobile/android && ./gradlew clean",
    "dev:android:release": "cd apps/mobile/android && ./gradlew assembleRelease",
    "dev:metro": "cd apps/mobile && node ./node_modules/metro/src/cli.js start --reset-cache --host 0.0.0.0",
    "dev:android:run": "cd apps/mobile && node ./node_modules/@react-native-community/cli/build/bin.js run-android",
    "release:ios": "turbo run release:ios",
    "release:android": "turbo run release:android",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "security:audit": "pnpm audit",
    "security:check": "turbo run security:check",
    "prepare-release": "turbo run build test:ci security:check && pnpm audit"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@foodwaste/eslint-config": "workspace:*",
    "@foodwaste/jest-config": "workspace:*",
    "@foodwaste/tsconfig": "workspace:*",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@react-native/eslint-config": "0.82.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "knip": "^6.0.6",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/react": "^19.1.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@typescript-eslint/type-utils": "^8.58.1",
    "@typescript-eslint/scope-manager": "^8.58.1",
    "@typescript-eslint/types": "^8.58.1",
    "@typescript-eslint/typescript-estree": "^8.58.1",
    "@typescript-eslint/utils": "^8.58.1",
    "@typescript-eslint/visitor-keys": "^8.58.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "recyclerlistview@4.2.3": "patches/recyclerlistview@4.2.3.patch"
    },
    "overrides": {
      "@sentry/core": "10.48.0",
      "typescript": "^5.9.3",
      "jest": "^29.7.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "handlebars": "^4.7.9",
      "multer": "^2.1.1",
      "serialize-javascript": "^7.0.5",
      "svgo": "^3.3.3",
      "flatted": "^3.4.2",
      "socket.io-parser": "^4.2.6",
      "node-forge": "^1.4.0",
      "@xmldom/xmldom": "^0.8.12",
      "lodash": "^4.18.0",
      "yaml": "^2.8.3",
      "fast-xml-parser": "^5.5.7",
      "ajv": "^8.18.0",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "express>path-to-regexp": "^0.1.13",
      "@nestjs/core>path-to-regexp": "^8.4.0",
      "@nestjs/platform-express>path-to-regexp": "^8.4.0",
      "@nestjs/swagger>path-to-regexp": "^8.4.0",
      "@tootallnate/once": "^3.0.1",
      "brace-expansion": "^2.0.3",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "@nestjs/common>file-type": "^22.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": ">=19.1.0",
        "react-dom": ">=19.1.0",
        "react-native-web": ">=0.21.0",
        "@react-native-async-storage/async-storage": ">=2.0.0",
        "expect": ">=27.2.5"
      },
      "ignoreMissing": [
        "react-native"
      ]
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@nestjs/core",
      "@parcel/watcher",
      "@scarf/scarf",
      "@sentry/cli",
      "@swc/core",
      "argon2",
      "bcrypt",
      "dtrace-provider",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
