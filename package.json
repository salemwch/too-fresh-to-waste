    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": ">=19.1.0",
        "react-dom": ">=19.1.0",
        "react-native-web": ">=0.21.0",
        "@react-native-async-storage/async-storage": ">=2.0.0",
        "expect": ">=27.2.5"
      },
      "ignoreMissing": [
        "react-native"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@firebase/util",
      "@mongodb-js/zstd",
      "@nestjs/core",
      "@parcel/watcher",
      "@scarf/scarf",
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "@swc/core",
      "argon2",
