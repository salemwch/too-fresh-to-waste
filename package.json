      "postcss": "^8.5.18",
      "react-email>next": "15.5.24",
      "react-email>glob": ">=10.5.0",
      "react-email>esbuild": ">=0.28.1",
      "protobufjs": ">=8.6.6",
      "prismjs": ">=1.30.0",
      "fast-xml-builder": ">=1.1.7",
      "uuid": ">=11.1.1",
      "ws": ">=8.20.1",
