      "nanoid@^3": "^3.3.17",
      "browserslist@^4": "^4.28.7",
      "postcss-selector-parser@^6": "^6.1.3",
      "eslint-plugin-ft-flow": "^3.0.11",
      "eslint-plugin-react-native": "^5.0.0",
      "metro@^0.83": "^0.83.8",
