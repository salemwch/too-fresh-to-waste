{
  // ─────────────────────────────────────────────────────────────────────────────
  // Root workspace TypeScript config.
  //
  // PURPOSE: project references + workspace-wide path aliases for IDE navigation.
  // COMPILER OPTIONS: live in packages/tsconfig — each app extends the right preset.
  //   • apps/food-waste-backend → @foodwaste/tsconfig/nestjs
  //   • apps/web               → @foodwaste/tsconfig/nextjs
  //   • apps/mobile            → @foodwaste/tsconfig/react-native
  //   • packages/shared        → @foodwaste/tsconfig/library
  //   • packages/ui            → @foodwaste/tsconfig/ui-library
  // ─────────────────────────────────────────────────────────────────────────────
  "extends": "@foodwaste/tsconfig/base",
  "compilerOptions": {
    // Workspace-wide path aliases — for IDE (not for app builds)
    "baseUrl": ".",
    "paths": {
      "@foodwaste/shared": ["./packages/shared/src"],
      "@foodwaste/shared/*": ["./packages/shared/src/*"],
      "@foodwaste/ui": ["./packages/ui/src"],
      "@foodwaste/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    "build",
    "**/build",
    "**/coverage",
    "**/.next",
    "**/android",
    "**/ios"
  ],
  "references": [
    { "path": "./packages/tsconfig" },
    { "path": "./packages/shared" },
    { "path": "./packages/ui" },
    { "path": "./apps/mobile" },
    { "path": "./apps/food-waste-backend" },
    { "path": "./apps/web" }
  ]
}
