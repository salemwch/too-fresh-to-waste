# pnpm workspace configuration
# Docs: https://pnpm.io/npmrc

# Automatically install peer dependencies (avoids manual peer-dep management)
auto-install-peers=true

# Don't fail on peer dependency mismatches (RN ecosystem has frequent peer conflicts)
strict-peer-dependencies=false

# Hoist node_modules for React Native compatibility (Metro requires flat structure)
node-linker=hoisted

# Dedupe packages to reduce disk usage and ensure single versions
dedupe-peer-dependents=true

# Use lockfile v9 format (pnpm 9+)
lockfile-include-tarball-url=false
