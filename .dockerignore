# -------------------------------------------------------
# Backend Docker build — .dockerignore
#
# Controls what enters the Docker build context. Anything
# listed here is invisible to every COPY instruction.
# -------------------------------------------------------

# pnpm config — node-linker=hoisted is needed for Metro but causes a Zod 3/4
# hoisting conflict in Docker. Omitting it lets pnpm default to isolated mode,
# where each workspace package resolves its own correct version.
.npmrc

# Dependencies and build artefacts (installed fresh in the deps stage)
node_modules
**/node_modules
dist
build
*.tsbuildinfo
.turbo
.next
.metro-cache

# Workspace packages not needed for backend compilation.
# Excluding them prevents pnpm from pulling react-native, next.js, and other
# frontend dep trees during the prod-install prune step.
apps/mobile
apps/web
packages/ui

# Version control
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Cache
.eslintcache
*.cache

# Test output
coverage
.nyc_output

# Docker (prevent recursive inclusion)
.dockerignore
docker-compose*.yml

# Documentation
*.md

# CI/CD
.github
.gitlab-ci.yml

# Temporary
.tmp
temp

# Secrets & keys
**/firebase-service-account.json
*.pem
*.key
*.keystore

# Plans and docs
docs
