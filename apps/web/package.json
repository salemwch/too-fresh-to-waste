{
  "name": "@foodwaste/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "check:opacity": "node scripts/check-opacity-scale.mjs",
    "fix:opacity": "node scripts/check-opacity-scale.mjs --fix",
    "check:canonical": "node scripts/check-canonical-tags.mjs",
    "check:translations": "node scripts/check-translation-coverage.mjs",
    "check:seo": "pnpm check:canonical && pnpm check:translations",
    "check:spacing": "node scripts/spacing-snapshot.mjs",
    "snapshot:spacing": "node scripts/spacing-snapshot.mjs --write",
    "check:design": "pnpm check:spacing && pnpm check:opacity",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "test:visual:ui": "playwright test --ui",
    "test:visual:install": "playwright install chromium"
  },
  "dependencies": {
    "@foodwaste/shared": "workspace:*",
    "@foodwaste/ui": "workspace:*",
    "@next/third-parties": "^16.2.9",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-direction": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-label": "2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "1.1.10",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@sentry/nextjs": "^10.58.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "^12.40.0",
    "gray-matter": "4.0.3",
    "jose": "5.9.6",
    "lucide-react": "0.468.0",
    "next": "15.5.24",
    "next-intl": "^4.13.0",
    "next-mdx-remote": "6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.8.1",
    "remark-gfm": "4.0.1",
    "socket.io-client": "4.8.3",
    "sonner": "1.7.2",
    "tailwind-merge": "2.6.0",
    "tslib": "2.8.1",
    "zod": "3.24.4",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.5",
    "@foodwaste/jest-config": "workspace:*",
    "@foodwaste/tsconfig": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.15",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.17.0"
  },
  "browserslist": [
    "Chrome >= 93",
    "Firefox >= 94",
    "Safari >= 15.4",
    "Edge >= 93",
    "not dead"
  ]
}
