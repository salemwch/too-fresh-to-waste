# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Too Fresh To Waste

# API Integration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000

# JWT verification (server-side only — NOT NEXT_PUBLIC_)
# Must match the backend JWT_SECRET. Used by Next.js middleware to verify
# the access_token HttpOnly cookie at the Edge (via jose).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Dev server allowed origins (comma-separated IPs for local network testing)
DEV_ALLOWED_ORIGINS=192.168.1.4

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=false

# Analytics (optional)
# Set to true to enable Google Analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# GA4 Measurement ID (format: G-XXXXXXXXXX) — set in .env.local or Vercel env vars
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=https://8f2a977a9a4e473ca0bf895ae8e79124@o4510811308359680.ingest.de.sentry.io/4511213216399440
SENTRY_AUTH_TOKEN=

# Google OAuth (consumer-facing Sign-In with Google)
# Get client ID from Google Cloud Console > Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps
#
# Required by the admin live driver map (/admin/drivers/map). Without it that
# page explains what to configure instead of rendering, and the driver list
# beside it still works - but nobody sees a map.
#
# Setup, all four steps:
#   1. Google Cloud console -> enable the "Maps JavaScript API" on the project
#   2. Enable billing (the API returns an error without it, even inside the
#      free tier)
#   3. Create an API key and paste it here / into Vercel
#   4. Restrict the key by HTTP referrer to your domains. NEXT_PUBLIC_* is
#      inlined into the client bundle, so this value is public by design -
#      referrer restriction is what stops someone else billing your project
#      with it.
#
# Because it is inlined at build time, changing it needs a REDEPLOY, not a
# restart.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# App Store Links
#
# These drive every "Download the app" button on the marketing site, plus the
# SEO config and the email verification page. Leave them EMPTY until the app is
# actually published: an empty value makes the buttons open the "coming soon"
# launch modal instead, which is the correct pre-launch behaviour.
#
# Setting one flips every button for that platform to a real link, with no code
# change and no redeploy of anything but the env. The two are independent, so
# setting only PLAY_STORE (this app ships Android; iOS needs a macOS runner) is
# the expected launch state - App Store buttons keep showing the modal rather
# than sending people to a 404.
#
# Must be https and on the store's own host, or the value is ignored and the
# button falls back to the modal. See src/lib/app-store-links.ts.
#
#   NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<your.package.name>
#   NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/tn/app/<slug>/id<numeric-id>
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Business Contact (SEO structured data)
NEXT_PUBLIC_CONTACT_EMAIL=contact@toofreshwaste.tn
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Social Media URLs (consumed by Footer + SEO)
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61585767061906
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/toofreshtowaste.tn/
NEXT_PUBLIC_SOCIAL_X=https://x.com/TooFresh2Waste
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/too-fresh-to-waste/
NEXT_PUBLIC_CREATOR_URL=https://www.linkedin.com/in/salem-wachwacha-h/

# Email Service (Brevo/SendinBlue) - Server-side only, NOT exposed to browser
BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_LIST_ID=2
BREVO_FROM_NAME=Too Fresh To Waste
BREVO_FROM_EMAIL=noreply@toofreshtowaste.com
BREVO_SUPPORT_EMAIL=support@toofreshtowaste.com

# Rate Limiting (Upstash Redis) - Server-side only
# Create a free database at https://console.upstash.com (10K requests/day free tier)
# Required in production; optional in dev (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bing Webmaster Tools verification

NEXT_PUBLIC_BING_VERIFICATION=