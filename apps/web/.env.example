# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Too Fresh To Waste

# API Integration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=false

# Analytics (optional)
# Set to true to enable Google Analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-95R7PQKMC6
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Maps (if location features needed)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# App Store Links (used on email verification success page)
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.foodwaste.app
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/too-fresh-to-waste/id000000000

# Email Service (Brevo/SendinBlue) - Server-side only, NOT exposed to browser
BREVO_API_KEY=your_brevo_api_key_here
