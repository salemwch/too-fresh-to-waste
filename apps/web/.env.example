# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Too Fresh To Waste

# API Integration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000

# JWT verification (server-side only — NOT NEXT_PUBLIC_)
# Must match the backend JWT_SECRET. Used by Next.js middleware to verify
# the access_token HttpOnly cookie at the Edge (via jose).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Dev server allowed origins (comma-separated IPs for local network testing)
DEV_ALLOWED_ORIGINS=192.168.1.4

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=false

# Analytics (optional)
# Set to true to enable Google Analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# GA4 Measurement ID (format: G-XXXXXXXXXX) — set in .env.local or Vercel env vars
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=https://8f2a977a9a4e473ca0bf895ae8e79124@o4510811308359680.ingest.de.sentry.io/4511213216399440
SENTRY_AUTH_TOKEN=

# Maps (if location features needed)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# App Store Links (used in SEO config + email verification page)
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Business Contact (SEO structured data)
NEXT_PUBLIC_CONTACT_EMAIL=contact@toofreshwaste.tn
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Social Media URLs (consumed by Footer + SEO)
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61585767061906
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/toofreshtowaste.tn/
NEXT_PUBLIC_SOCIAL_X=https://x.com/TooFresh2Waste
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/too-fresh-to-waste/
NEXT_PUBLIC_CREATOR_URL=https://www.linkedin.com/in/salem-wachwacha-h/

# Email Service (Brevo/SendinBlue) - Server-side only, NOT exposed to browser
BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_LIST_ID=2
BREVO_FROM_NAME=Too Fresh To Waste
BREVO_FROM_EMAIL=noreply@toofreshtowaste.com
BREVO_SUPPORT_EMAIL=support@toofreshtowaste.com

# Rate Limiting (Upstash Redis) - Server-side only
# Create a free database at https://console.upstash.com (10K requests/day free tier)
# Required in production; optional in dev (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
