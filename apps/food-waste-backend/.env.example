# ============================================
# TOO FRESH TO WASTE - BACKEND API
# ============================================
#
# SECURITY WARNING: NEVER commit .env files to version control!
# This is a TEMPLATE file only. Copy to .env.development, .env.staging, or .env.production
# and fill with your actual credentials.
#
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development # development | staging | production
PORT=3000
ENABLE_HTTPS=false
APP_NAME=Too Fresh To Waste
SUPPORT_EMAIL=support@toofreshtowaste.com
MIN_APP_VERSION=0.0.0 # Minimum mobile app version (semver). Requests below this get 426.
LOGS_DIR=logs # Winston log file directory (default: 'logs'). Override for Docker/k8s volume mounts.
WEBHOOK_SIGNATURE_TOLERANCE=300 # Max age in seconds for webhook timestamps (replay protection).

# ============================================
# AUTO-FEATURING CONFIGURATION
# ============================================
# Urgency threshold for auto-featuring offers (in hours)
# Offers with this many hours or less remaining will be auto-featured as "Urgent Deals"
# Default: 3 hours
# Recommended: 1-2 hours for stricter "last hours" urgency
AUTO_FEATURE_URGENCY_HOURS=3

# Minimum time offer must exist before auto-featuring (prevents gaming)
# Default: 0.5 hours (30 minutes)
AUTO_FEATURE_MIN_EXISTENCE_HOURS=0.5

# Enable/disable auto-featuring system
# Default: true
AUTO_FEATURE_ENABLED=true

# Cron schedule for auto-featuring job
# Default: */1 * * * * (every 1 minute)
AUTO_FEATURE_CRON_SCHEDULE=*/1 * * * *

# Backend URL (for email verification redirect links)
# Development: http://localhost:3000
# Production: https://api.yourapp.com
BACKEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
# Development: leave empty (defaults to localhost origins)
# Production: REQUIRED — set to your actual domains
# Supports regex patterns with "regex:" prefix
# Example: https://toofreshtowaste.com,https://admin.toofreshtowaste.com,regex:^https://[a-z0-9-]+\.ngrok\.app$
CORS_ORIGINS=

# Frontend URL for CORS and deep linking
# Mobile deep link scheme: foodwaste://auth
# Web frontend: https://yourapp.com
FRONTEND_URL=foodwaste://auth

# Web Frontend URL (optional - for password reset web fallback)
# Leave empty if you don't have a web frontend
# Development: http://localhost:3001  — must be http:// in dev (no SSL cert on dev server)
# Production:  https://toofreshtowaste.com
WEB_FRONTEND_URL=http://localhost:3001

# ============================================
# DATABASE CONFIGURATION
# ============================================
# 
# Production: mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://foodwaste_user:<password>@cluster0.61uimdv.mongodb.net/test?retryWrites=true&w=majority&appName=Cluster0&compressors=zstd,snappy,zlib
# Enterprise-Grade MongoDB Connection Pooling
# Reference: https://www.mongodb.com/docs/drivers/node/current/fundamentals/connection/connection-options/

# Maximum number of connections in the connection pool
# Production: 100 | Staging: 50 | Development: 20
MONGO_MAX_POOL_SIZE=20

# Minimum number of connections to maintain
MONGO_MIN_POOL_SIZE=5

# Close idle connections after this duration (milliseconds)
MONGO_MAX_IDLE_TIME_MS=60000

# Maximum time to wait for an available connection (milliseconds)
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# Socket timeout for operations (milliseconds)
MONGO_SOCKET_TIMEOUT_MS=45000

# Initial connection timeout (milliseconds)
MONGO_CONNECT_TIMEOUT_MS=30000

# Server selection timeout (milliseconds)
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000

# Health check frequency (milliseconds)
MONGO_HEARTBEAT_FREQUENCY_MS=10000

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_TLS=false

# Redis SSL Configuration (if TLS is enabled)
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_TLS_CHECK_SERVER_IDENTITY=true
REDIS_TLS_MIN_VERSION=TLSv1.2

# Redis connection settings
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=3

# ============================================
# RABBITMQ MESSAGE BROKER
# ============================================
# RabbitMQ connection URL (AMQP protocol)
# Development: amqp://admin:password@localhost:5672/vhost
# Production: amqps://user:pass@rabbitmq.example.com:5671/foodwaste
# Docker: Use service name 'rabbitmq' as hostname
RABBITMQ_URL=amqp://admin:rabbitmq_dev_password@localhost:5672/foodwaste

# Enable RabbitMQ (set to 'false' to use EventEmitter2 fallback)
# Use 'false' for development until you're ready to test RabbitMQ
RABBITMQ_ENABLED=true

# Comma-separated list of events to route to RabbitMQ (glob patterns supported)
# Examples:
#   admin.user.*            - All admin user events
#   admin.*                 - All admin events
#   *                       - All events (full migration)
#   admin.user.suspended,admin.user.blocked - Specific events
# Leave empty to use EventEmitter2 for all events (safe default)
RABBITMQ_ENABLED_EVENTS=

# Main exchange for event publishing (topic exchange)
RABBITMQ_EXCHANGE=foodwaste.events

# Prefetch count (messages per consumer, controls backpressure)
# Lower values = better load distribution, higher values = better throughput
# Production: 10 | Development: 5
RABBITMQ_PREFETCH_COUNT=10

# Message TTL in milliseconds (24 hours = 86400000ms)
# Messages older than this will be moved to dead letter queue
RABBITMQ_MESSAGE_TTL=86400000

# ============================================
# JWT CONFIGURATION
# ============================================
# SECURITY: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d

# ============================================
# COOKIE CONFIGURATION
# ============================================
# SECURITY: Required for signed session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Falls back to JWT_SECRET if not set, but should be unique in production
COOKIE_SECRET=CHANGE_ME_TO_RANDOM_128_CHAR_HEX_STRING
# Cookie domain (leave empty for current domain only in development)
COOKIE_DOMAIN=

# ============================================
# PASSWORD SECURITY CONFIGURATION
# ============================================
# Number of previous passwords to track and prevent reuse (NIST: 3, OWASP: 5)
PASSWORD_HISTORY_COUNT=1
# Enable/disable password history enforcement
PASSWORD_ENFORCE_HISTORY=true

# Password Policy Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
PASSWORD_MIN_SCORE=2
PASSWORD_PREVENT_COMMON=true
PASSWORD_PREVENT_PERSONAL_INFO=false
PASSWORD_PREVENT_REPEATING=true
PASSWORD_MAX_REPEATING_CHARS=2
PASSWORD_SPECIAL_CHARACTERS=!@#$%^&*()_+-=[]{}|;:,.<>?

# ============================================
# SESSION MANAGEMENT CONFIGURATION
# ============================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30m
SESSION_MAX_CONCURRENT=5
SESSION_TIMEOUT_MS=900000
SESSION_REMEMBER_ME_MS=2592000000
SESSION_CLEANUP_INTERVAL_MS=300000
SESSION_SUSPICIOUS_THRESHOLD=3

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# Namecheap Private Email SMTP settings
# Docs: https://www.namecheap.com/support/knowledgebase/article.aspx/9441/2279/how-to-set-up-smtp/
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=support@toofreshtowaste.com
SMTP_PASS=your-namecheap-email-password
SMTP_FROM_EMAIL=support@toofreshtowaste.com
SMTP_FROM_NAME=Too Fresh To Waste

# ============================================
# FIREBASE CONFIGURATION (Push Notifications only)
# ============================================
# Service account JSON file for Firebase Admin SDK (FCM push notifications)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# SECURITY: Never commit this file — store in CI secret store for deployments
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Firebase project ID (found in Firebase Console → Project Settings → General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ============================================
# SUPABASE STORAGE CONFIGURATION
# ============================================
# Supabase project URL (found in Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (SECRET - never expose to client)
# Found in: Supabase Dashboard → Settings → API → service_role secret
# SECURITY: Never commit actual keys — store in CI secret store for deployments
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket name (create in Supabase Dashboard → Storage)
# Default: uploads
SUPABASE_STORAGE_BUCKET=uploads

# Maximum file upload size in MB (default: 10)
# Applies to all uploads: profile images, establishment images, offer images, documents
SUPABASE_MAX_FILE_SIZE_MB=10

# ============================================
# TWILIO SMS CONFIGURATION
# ============================================
# SECURITY: Get from Twilio Console (https://console.twilio.com/)
# NEVER commit real credentials — use CI secret store for deployments
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Android SMS Retriever API Hash (11 characters)
# Generate this by running the Android app in debug mode and checking logcat
# Example: ABC12defGHI
# Leave empty to use basic SMS format (works but less secure)
SMS_RETRIEVER_HASH=

# ============================================
# MFA CONFIGURATION
# ============================================
MFA_ISSUER_NAME="FoodWaste App"

# ============================================
# GOOGLE PLACES API CONFIGURATION
# ============================================
# Google Places API Key for location search (Tunisia-restricted)
# SECURITY: This key MUST be restricted in Google Cloud Console to:
# - API Restrictions: Places API, Geocoding API ONLY
# - Application Restrictions: Backend server IP addresses ONLY
# - Geographic restriction: Tunisia (country:tn) ONLY
# How to get: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# NEVER commit actual API keys - this is a template
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Request timeout in milliseconds
GOOGLE_PLACES_TIMEOUT=10000

# Maximum results to return per search
GOOGLE_PLACES_MAX_RESULTS=5

# ============================================
# GEOAPIFY GEOCODING API CONFIGURATION
# ============================================
# Geoapify API Key for reverse/forward geocoding (free tier: 3,000 req/day)
# Get your key at: https://myprojects.geoapify.com/
# NEVER commit actual API keys - this is a template
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GEOAPIFY_TIMEOUT=10000

# ============================================
# PAYMENT CONFIGURATION (SMT Tunisia)
# ============================================
SMT_MERCHANT_ID=your-merchant-id
SMT_TERMINAL_ID=your-terminal-id
SMT_API_KEY=your-api-key
SMT_API_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
SMT_WEBHOOK_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_HEX_STRING
SMT_BASE_URL=http://localhost:3001 # or https://api.smt.tn for production
SMT_ENVIRONMENT=sandbox # sandbox | production
SMT_TIMEOUT=30000
SMT_MAX_RETRIES=3

# Secure encryption salt (generate with: crypto.randomBytes(64).toString('hex'))
SMT_ENCRYPTION_SALT=CHANGE_ME_TO_RANDOM_128_CHAR_HEX_STRING

# Payment processing fees
PAYMENT_PROCESSING_FEE_RATE=0.029
PAYMENT_MIN_FEE=0.5
PAYMENT_MAX_FEE=50
PAYMENT_SESSION_TIMEOUT=1800

# Payment encryption key (32 bytes hex)
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_32_BYTE_HEX_STRING

# Webhook signature tolerance (seconds)
WEBHOOK_SIGNATURE_TOLERANCE=300

# ============================================
# PRIVACY / GDPR ENCRYPTION
# ============================================
# Required in production for GDPR/Tunisian Law No. 2004-63 compliance
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVACY_ENCRYPTION_KEY=

# ============================================
# SSL CERTIFICATES (for HTTPS)
# ============================================
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.cert

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=5242880 # 5MB in bytes
UPLOAD_PATH=./uploads

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_TTL=60000 # 60 seconds
THROTTLE_LIMIT=100 # 100 requests per TTL window

# ============================================
# AUTO-FEATURING CONFIGURATION
# ============================================
# Minimum time (hours) an offer must exist before auto-featuring
# Prevents gaming by creating very short offers that appear urgent immediately
# Default: 0.5 (30 minutes)
AUTO_FEATURE_MIN_EXISTENCE_HOURS=0.5

# Time threshold (hours) for considering an offer "urgent"
# Offers with this many hours or less remaining get auto-featured
# Default: 3 hours
AUTO_FEATURE_URGENCY_HOURS=3

# Cron schedule for auto-featuring job
# Default: Every 1 minute ('*/1 * * * *')
AUTO_FEATURE_CRON_SCHEDULE=*/1 * * * *

# Enable/disable auto-featuring system
# Set to 'false' to disable auto-featuring
# Default: true
AUTO_FEATURE_ENABLED=true

# ============================================
# ADMIN CONFIGURATION
# ============================================
# WARNING: Change immediately after first login!
ADMIN_EMAIL=admin@foodwaste.com
ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# ============================================
# MONITORING & LOGGING
# ============================================

# ---------------------------------------
# Winston Logging Configuration
# ---------------------------------------
# Log level: silly | debug | verbose | http | info | warn | error
# Production: info | Staging: debug | Development: debug
LOG_LEVEL=info

# Directory for log files (production only)
# Winston will create daily rotating log files in this directory
LOGS_DIR=./logs

# ---------------------------------------
# Sentry Error Tracking & Performance Monitoring
# ---------------------------------------
# CRITICAL: Sentry provides real-time error tracking, performance monitoring,
# and alerting for production issues. Set up at https://sentry.io

# Sentry DSN (Data Source Name) - Get from Sentry project settings
# Format: https://<public-key>@<organization>.ingest.sentry.io/<project-id>
# Leave empty to disable Sentry (development/test)
SENTRY_DSN=

# Environment identifier (matches NODE_ENV or custom staging identifier)
# Used for filtering errors in Sentry dashboard
SENTRY_ENVIRONMENT=development

# Release identifier for tracking deployments
# Format: project-name@version (e.g., foodwaste-backend@1.2.3)
# Auto-generated from package.json version if not set
SENTRY_RELEASE=

# Performance monitoring sample rate (0.0 to 1.0)
# Production: 0.1 (10% of transactions) - reduces cost
# Staging: 0.5 (50% of transactions) - better debugging
# Development: 1.0 (100% of transactions) - full visibility
SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate (0.0 to 1.0) - CPU profiling for performance
# Production: 0.1 (10%) | Staging: 0.5 (50%) | Development: 0 (disabled)
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Server name for multi-instance deployments
# Useful for identifying which instance reported the error
# Auto-detected from hostname if not set
SERVER_NAME=

# ---------------------------------------
# Prometheus Metrics & Monitoring
# ---------------------------------------
# Enable/disable Prometheus metrics collection
PROMETHEUS_METRICS_ENABLED=true

# Query Performance Monitoring
# Enable slow query tracking (monitors database operations)
ENABLE_QUERY_MONITORING=true

# Slow query threshold in milliseconds (queries exceeding this will be logged)
# Production: 1000ms | Development: 500ms
SLOW_QUERY_THRESHOLD_MS=1000

# ---------------------------------------
# Health Check Configuration
# ---------------------------------------
# Memory thresholds for health checks (in MB)
# Health check fails if memory usage exceeds these values
HEALTH_CHECK_MEMORY_HEAP_THRESHOLD_MB=150
HEALTH_CHECK_MEMORY_RSS_THRESHOLD_MB=150

# Database ping timeout for health checks (in milliseconds)
HEALTH_CHECK_DB_TIMEOUT_MS=3000

# Redis ping timeout for health checks (in milliseconds)
HEALTH_CHECK_REDIS_TIMEOUT_MS=3000

# ============================================
# SECURITY NOTES
# ============================================
# 1. Generate strong secrets using crypto.randomBytes()
# 2. Use different secrets for each environment
# 3. Store production secrets in a secrets manager (AWS Secrets Manager, HashiCorp Vault, GitHub Secrets)
# 4. Rotate secrets every 90 days
# 5. Never commit .env files to version control
# 6. Review access logs regularly for suspicious activity
# 7. Enable 2FA for all admin accounts
# ============================================
