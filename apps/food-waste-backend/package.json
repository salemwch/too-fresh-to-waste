{
  "name": "@foodwaste/backend",
  "version": "1.0.0",
  "description": "Backend API for Food Waste Marketplace Application",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:pm2:prod": "pm2 start ecosystem.config.js --env production",
    "reload:pm2": "pm2 reload ecosystem.config.js --env production",
    "lint": "eslint src --fix",
    "test": "jest",
    "check:ts": "tsc --noEmit",
    "check:lint": "eslint src",
    "check:format": "prettier --check .",
    "check:test": "jest --passWithNoTests",
    "check:docs": "node ../../scripts/check-module-readmes.js",
    "check:all": "pnpm check:ts && pnpm check:lint && pnpm check:format && pnpm check:test && pnpm check:docs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config jest-e2e.config.js --detectOpenHandles",
    "seed:admin": "ts-node -r tsconfig-paths/register src/seeds/seed-admin.ts",
    "migration:normalize-phones": "ts-node -r tsconfig-paths/register scripts/migrations/normalize-phone-numbers.ts",
    "migration:normalize-phones:execute": "ts-node -r tsconfig-paths/register scripts/migrations/normalize-phone-numbers.ts --execute",
    "diagnose:featured": "node scripts/diagnose-featured-offers.js",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "test:load": "jest --config ./test/jest-load.json",
    "test:security": "jest --testPathPatterns=security",
    "test:unit": "jest --testPathPatterns=spec.ts",
    "test:integration": "jest --testPathPatterns=controller",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "clean": "rimraf dist node_modules/.cache",
    "security:check": "pnpm audit --recursive",
    "verify:indexes": "ts-node -r tsconfig-paths/register scripts/verify-indexes.ts",
    "deps:validate": "depcruise src --config .dependency-cruiser.js",
    "deps:report": "depcruise src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph": "depcruise src --config .dependency-cruiser.js --output-type dot | dot -T svg > dependency-graph.svg"
  },
  "keywords": [],
  "author": "Salem wachwacha",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@foodwaste/shared": "workspace:*",
    "@golevelup/nestjs-rabbitmq": "^7.1.1",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@sentry/node": "^10.26.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@supabase/storage-js": "^2.100.1",
    "@supabase/supabase-js": "2.49.4",
    "argon2": "^0.44.0",
    "axios": "^1.12.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-writer": "^1.6.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.5.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "iso-3166-1-alpha-2": "^1.0.2",
    "joi": "17.13.3",
    "libphonenumber-js": "^1.12.23",
    "luxon": "^3.7.2",
    "minimatch": "^10.0.3",
    "mongoose": "^8.18.0",
    "ms": "^2.1.3",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "twilio": "^5.10.0",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/geoip-lite": "1.4.4",
    "@types/iso-3166-1-alpha-2": "^1.0.2",
    "@types/jest": "^29.5.13",
    "@types/luxon": "^3.7.1",
    "@types/multer": "2.1.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/speakeasy": "^2.0.10",
    "@types/xml2js": "0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "dependency-cruiser": "^17.3.6",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=10.17.0"
  }
}
