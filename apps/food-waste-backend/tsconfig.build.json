{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "rootDir": "./src",
    "paths": {
      "@foodwaste/shared": ["../../packages/shared/dist"],
      "@foodwaste/shared/*": ["../../packages/shared/dist/*"],
      "src/*": ["./src/*"],
      "csv-writer": ["./src/common/types/csv-writer.shim.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "../../node_modules",
    "dist",
    "**/dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "coverage",
    "scripts"
  ],
  "references": []
}
