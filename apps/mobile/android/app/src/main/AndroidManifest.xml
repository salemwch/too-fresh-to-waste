<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Location Permissions (required for Maps and Geolocation) -->
    <!-- Source: https://github.com/react-native-maps/react-native-maps/blob/master/docs/installation.md -->
    <!-- Source: https://developer.android.com/develop/sensors-and-location/location/permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Push Notifications - required on Android 13+ (API 33+) -->
    <!-- Source: https://developer.android.com/develop/ui/views/notifications/notification-permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: required for Linking.canOpenURL('whatsapp://') -->
    <!-- Source: https://developer.android.com/training/package-visibility -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">

      <!-- Google Maps API Key -->
      <meta-data
          android:name="com.google.android.geo.API_KEY"
          android:value="@string/GOOGLE_MAPS_API_KEY" />

      <!-- Default FCM notification channel (sound + vibration on Android 8+) -->
      <!-- tools:replace overrides react-native-firebase_messaging's empty default value -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_channel_id"
          android:value="tftw_default"
          tools:replace="android:value" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Main launcher intent -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- Custom URL Scheme: foodwaste:// (development / QR testing) -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="foodwaste" />
        </intent-filter>

        <!--
          Android App Links — toofreshtowaste.com
          autoVerify="true" → Android fetches
          https://toofreshtowaste.com/.well-known/assetlinks.json at install time.
          Once verified, the OS opens the app directly without a disambiguation dialog.

          Paths are intentionally narrow: only intercept links this app can handle.
          Other paths (e.g. /about, /blog) continue to open in the browser.
        -->
        <!-- Email verification magic link -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https"
                  android:host="toofreshtowaste.com"
                  android:pathPrefix="/verify-email" />
        </intent-filter>

        <!-- Password reset link -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https"
                  android:host="toofreshtowaste.com"
                  android:pathPrefix="/reset-password" />
        </intent-filter>

        <!-- Login link (OAuth sign-in email redirects here) -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https"
                  android:host="toofreshtowaste.com"
                  android:pathPrefix="/login" />
        </intent-filter>
      </activity>
    </application>
</manifest>
