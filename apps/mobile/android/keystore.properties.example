# Android Release Signing — Local Development
# =============================================
# Copy this file to keystore.properties (gitignored) and fill in your values.
# NEVER commit keystore.properties or any .keystore file.
#
# Generate a keystore (one-time, run from repo root):
#   keytool -genkey -v \
#     -keystore apps/mobile/android/app/release.keystore \
#     -alias toofreshtowaste \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then encode for GitHub Secrets (CI):
#   base64 -w 0 apps/mobile/android/app/release.keystore > release.keystore.b64
#   # Copy the contents of release.keystore.b64 → GitHub Secret: KEYSTORE_BASE64
#
# GitHub Secrets required for android-release.yml:
#   KEYSTORE_BASE64    — base64-encoded keystore file
#   KEYSTORE_PASSWORD  — keystore password (set below)
#   KEY_ALIAS          — key alias (set below)
#   KEY_PASSWORD       — key password (set below)

# Path is relative to the android/ directory (where this file lives)
storeFile=app/release.keystore
storePassword=your-keystore-password
keyAlias=toofreshtowaste
keyPassword=your-key-password
