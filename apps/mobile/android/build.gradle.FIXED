// Top-level build file for Food Waste Mobile App
// React Native 0.81.0 + Android Gradle Plugin 8.7.3
// Source: https://reactnative.dev/docs/environment-setup
//
// ENTERPRISE FIX APPLIED - October 23, 2025
// Changes:
// - Added React Native Gradle Plugin to buildscript dependencies
// - Fixed AGP version from 8.13.0 → 8.7.3 (RN 0.81 compatible)
// - Fixed Kotlin version consistency (2.0.21)
// - Updated NDK version to match RN 0.77 template (27.1.12297006)
// - Removed invalid React Native Maven repository path

buildscript {
    ext {
        // Android SDK versions
        // Source: React Native 0.81 requires Android API 35
        // MinSdk 24 required by React Native 0.81.0
        buildToolsVersion = "35.0.0"
        minSdkVersion = 24
        compileSdkVersion = 35
        targetSdkVersion = 35
        ndkVersion = "27.1.12297006"  // FIXED: Was 27.2.12479018

        // React Native configuration
        // hermesEnabled defined in gradle.properties
        hermesEnabled = project.hasProperty("hermesEnabled") ? project.hermesEnabled == "true" : true
        newArchEnabled = project.hasProperty("newArchEnabled") ? project.newArchEnabled == "true" : false

        // Dependency versions
        // FIXED: Was 2.1.20, now aligned with RN 0.77 template
        kotlinVersion = "2.0.21"
        googleServicesVersion = "4.4.2"
        firebaseBomVersion = "33.7.0"
    }

    repositories {
        google()
        mavenCentral()
    }

    dependencies {
        // Android Gradle Plugin 8.7.3
        // Source: https://developer.android.com/build/releases/gradle-plugin
        // FIXED: Was 8.13.0 (incompatible), now 8.7.3 (RN 0.81 max supported)
        classpath('com.android.tools.build:gradle:8.7.3')

        // Google Services plugin for Firebase
        classpath("com.google.gms:google-services:$googleServicesVersion")

        // Kotlin plugin
        // FIXED: Now uses $kotlinVersion variable for consistency (was hardcoded 2.2.0)
        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin:$kotlinVersion")

        // React Native Gradle Plugin
        // CRITICAL FIX: This was MISSING - caused "Plugin with id 'com.facebook.react' not found"
        // Source: https://reactnative.dev/docs/react-native-gradle-plugin
        classpath("com.facebook.react:react-native-gradle-plugin")
    }
}

allprojects {
    repositories {
        google()
        mavenCentral()

        // REMOVED: Invalid React Native Maven repository
        // The following path doesn't exist in React Native 0.81:
        // maven {
        //     url("$rootDir/../node_modules/react-native/android")
        // }
        // React Native artifacts are now resolved from mavenCentral()

        // JSC (JavaScriptCore) repository - not used, Hermes enabled
        // Kept for reference if JSC needed in future
        maven {
            url("$rootDir/../node_modules/jsc-android/dist")
        }
    }
}
