{
  // React Native 0.87 mobile app — extends @foodwaste/tsconfig/react-native preset.
  // Only app-specific paths, types, and includes live here.
  "extends": "@foodwaste/tsconfig/react-native",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@foodwaste/shared": ["../../packages/shared/src"],
      "@foodwaste/shared/*": ["../../packages/shared/src/*"],
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/screens/*": ["./src/screens/*"],
      "@/services/*": ["./src/services/*"],
      "@/store/*": ["./src/store/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/config/*": ["./src/config/*"],
      "@/assets/*": ["./src/assets/*"]
    },
    // Jest + Node (for NodeJS.Timeout etc.). "react-native" is not listed: since
    // 0.87 its types are reached through package.json "exports" when imported,
    // and there is no top-level types entry for a global include to find.
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "index.js", "**/*.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
