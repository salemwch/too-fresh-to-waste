{
  "name": "@foodwaste/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Food Waste Mobile App - React Native TypeScript",
  "main": "index.js",
  "scripts": {
    "// METRO BUNDLER COMMANDS": "",
    "dev": "react-native start",
    "start": "react-native start",
    "metro": "react-native start",
    "metro:reset": "react-native start --reset-cache",
    "metro:debug": "METRO_DEBUG=1 react-native start",
    "metro:perf": "NODE_ENV=production react-native start",
    "// BUILD COMMANDS": "",
    "build": "pnpm build:android:release",
    "build:android:debug": "cd android && gradlew assembleDebug",
    "build:android:release": "cd android && gradlew assembleRelease",
    "build:android:bundle": "cd android && gradlew bundleRelease",
    "build:ios:debug": "cd ios && xcodebuild -workspace FoodWasteApp.xcworkspace -scheme FoodWasteApp -configuration Debug -sdk iphonesimulator",
    "build:ios:release": "cd ios && xcodebuild -workspace FoodWasteApp.xcworkspace -scheme FoodWasteApp -configuration Release -sdk iphoneos -archivePath build/FoodWasteApp.xcarchive archive",
    "// RUN COMMANDS": "",
    "dev:android": "react-native run-android",
    "dev:ios": "react-native run-ios --simulator='iPhone 15'",
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator='iPhone 15'",
    "// BUNDLE ANALYSIS & OPTIMIZATION": "",
    "bundle:android": "NODE_ENV=production react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ --minify --sourcemap-output android/app/build/index.android.bundle.map",
    "bundle:ios": "NODE_ENV=production react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios/ --minify --sourcemap-output ios/main.jsbundle.map",
    "bundle:analyze:android": "NODE_ENV=production react-native bundle --platform android --dev false --entry-file index.js --bundle-output ./build/index.android.bundle --sourcemap-output ./build/index.android.bundle.map --verbose",
    "bundle:analyze:ios": "NODE_ENV=production react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ./build/index.ios.bundle --sourcemap-output ./build/index.ios.bundle.map --verbose",
    "bundle:size": "pnpm bundle:analyze:android && pnpm bundle:size:report",
    "bundle:size:report": "node -e \"const fs=require('fs');const path='./build/index.android.bundle';if(fs.existsSync(path)){const stats=fs.statSync(path);const size=(stats.size/(1024*1024)).toFixed(2);console.log('Bundle Size:',size,'MB');console.log('Gzipped (estimated):',((stats.size*0.3)/(1024*1024)).toFixed(2),'MB')}else{console.log('Bundle not found. Run bundle:analyze:android first')}\"",
    "// CODE QUALITY": "",
    "lint": "eslint . --cache --cache-location ../../.eslintcache",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix --cache --cache-location ../../.eslintcache",
    "type-check": "tsc --noEmit --project .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "// TESTING": "",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=__tests__/unit --passWithNoTests",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "// CLEANING": "",
    "clean": "rimraf .metro-cache build android/app/build node_modules/.cache",
    "clean:metro": "rimraf .metro-cache",
    "clean:cache": "pnpm clean:metro",
    "android:clean": "cd android && gradlew clean",
    "check:fresh-install": "powershell -ExecutionPolicy Bypass -File ./scripts/fresh-install-check.ps1",
    "check:assets": "node scripts/check-assets.js",
    "assets:optimize": "node scripts/optimize-assets.js",
    "assets:subset-icons": "node scripts/subset-icon-font.js",
    "ios:clean": "cd ios && xcodebuild clean -workspace FoodWasteApp.xcworkspace -scheme FoodWasteApp",
    "clean:full": "pnpm clean && pnpm android:clean && rimraf node_modules && pnpm install",
    "// PERFORMANCE BENCHMARKS": "",
    "perf:bundle": "time NODE_ENV=production pnpm bundle:analyze:android",
    "perf:metro:cold": "pnpm clean:metro && time pnpm metro:reset",
    "perf:metro:warm": "time pnpm metro",
    "// iOS SPECIFIC": "",
    "postinstall": "node -e \"if (process.platform === 'darwin') { require('child_process').execSync('cd ios && pod install --repo-update', {stdio: 'inherit'}) }\"",
    "pods:install": "cd ios && pod install",
    "// SECURITY & RELEASE": "",
    "security:check": "npx audit-ci --config audit-ci.json",
    "release:ios": "fastlane ios release",
    "release:android": "fastlane android release"
  },
  "dependencies": {
    "@foodwaste/shared": "workspace:*",
    "@hookform/resolvers": "^3.10.0",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.6.0",
    "@react-native-firebase/messaging": "^21.6.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/ionicons": "12.4.1",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react-native": "^7.13.0",
    "@shopify/flash-list": "1.8.3",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "axios": "^1.18.0",
    "i18next": "24.2.3",
    "intl-pluralrules": "2.0.1",
    "react": "19.1.0",
    "react-hook-form": "^7.79.0",
    "react-i18next": "15.7.4",
    "react-native": "0.81.0",
    "react-native-config": "^1.7.2",
    "react-native-fast-image": "8.6.3",
    "react-native-gesture-handler": "^2.22.2",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^7.2.3",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "3.7.0",
    "react-native-maps": "1.29.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.35.9",
    "react-native-permissions": "^5.6.2",
    "react-native-progress": "^5.0.1",
    "react-native-restart": "0.0.28",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.24.0",
    "react-native-sms-retriever": "^1.1.1",
    "react-native-svg": "^15.15.5",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-webview": "14.0.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "tslib": "2.8.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@foodwaste/jest-config": "workspace:*",
    "@foodwaste/tsconfig": "workspace:*",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/metro-config": "0.81.0",
    "@testing-library/react-native": "^13.2.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "metro-cache": "^0.83.8",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.1.0",
    "rimraf": "^5.0.5",
    "sharp": "^0.35.4",
    "subset-font": "2.7.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.17.0"
  }
}
