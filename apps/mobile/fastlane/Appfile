# Fastlane Appfile — App-level identifiers
# Docs: https://docs.fastlane.tools/advanced/Appfile/

# Android package name (must match build.gradle applicationId)
package_name("com.foodwasteapp")

# Google Play JSON key — loaded from CI env var at runtime, not stored here.
# To generate: Google Play Console → Setup → API access → Create service account
# Docs: https://docs.fastlane.tools/actions/supply/#setup
json_key_data(ENV["GOOGLE_PLAY_JSON_KEY"])
