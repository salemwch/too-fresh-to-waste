source "https://rubygems.org"

# CocoaPods — iOS dependency manager
# Docs: https://guides.cocoapods.org
gem "cocoapods", "~> 1.16"

# Floors for CocoaPods' own dependencies - security patches, not the React
# Native template's pins. The template (rn-diff-purge 0.87.1) pins
# `xcodeproj < 1.26.0` and `concurrent-ruby < 1.3.4`, written for CocoaPods
# 1.15. They do not fit this Gemfile:
#   - `xcodeproj < 1.26.0` (react/react-native#47237) was a CI hotfix for
#     CocoaPods 1.15. Every CocoaPods 1.16+ requires xcodeproj >= 1.26, so
#     with `cocoapods ~> 1.16` the pin made the Gemfile unresolvable.
#   - `concurrent-ruby < 1.3.4` guarded against 1.3.5 dropping its `logger`
#     require, which crashed ActiveSupport < 7.1 (react/react-native#48966).
#     ActiveSupport 7.2 requires `logger` itself and `logger` is declared
#     below, and the pin held concurrent-ruby inside its advisories.
# Floors: activesupport GHSA-cg4j-q9v8-6v38, GHSA-89vf-4333-qx8v,
# GHSA-2j26-frm8-cmj9; concurrent-ruby GHSA-h8w8-99g7-qmvj,
# GHSA-wv3x-4vxv-whpp, GHSA-6wx8-w4f5-wwcr.
# Resolution and loading are verified under Ruby 3.3 (CI's version); see
# .claude/work/dependabot-alerts-2026-10.md.
gem "activesupport", ">= 7.2.3.1"
gem "concurrent-ruby", ">= 1.3.7"

# Ruby 3.4 removed these from the default gems; CocoaPods still requires them
# (`nkf` added by the RN 0.87 template). Harmless on Ruby 3.3, which CI uses.
gem "bigdecimal"
gem "logger"
gem "benchmark"
gem "mutex_m"
gem "nkf"

# Fastlane — automates building, testing, and releasing mobile apps
# Docs: https://docs.fastlane.tools
gem "fastlane", "~> 2.226"

# Google Play Store plugin (bundled with fastlane, listed explicitly for clarity)
# Docs: https://docs.fastlane.tools/actions/upload_to_play_store/
plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
