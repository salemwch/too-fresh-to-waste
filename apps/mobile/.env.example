# ==================================
# TOO FRESH TO WASTE - MOBILE APP
# ==================================
# Template for environment configuration
# Copy to create: .env.development, .env.staging, .env.production
# ==================================

# ---------------------------------
# APP CONFIGURATION
# ---------------------------------
APP_NAME=Too Fresh To Waste
APP_VERSION=1.0.0
BUNDLE_IDENTIFIER=com.foodwaste.app
ENVIRONMENT=development

# ---------------------------------
# API CONFIGURATION
# ---------------------------------
# Android Emulator: Use 10.0.2.2 (maps to host machine's localhost)
# iOS Simulator: Use localhost
# Real Device: Use your computer's local IP (e.g., 192.168.1.100)
# Example: API_BASE_URL=http://10.0.2.2:3000/api/v1
API_BASE_URL=http://localhost:3000/api/v1
WEBSOCKET_URL=ws://localhost:3000
API_TIMEOUT=30000
API_RETRY_COUNT=3

# ---------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------
JWT_REFRESH_THRESHOLD=300000
SESSION_TIMEOUT=3600000
STORAGE_ENCRYPTION_KEY=your-encryption-key-here

# ---------------------------------
# FIREBASE CONFIGURATION
# ---------------------------------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=toofreshtowaste.firebasestorage.app 
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abcdef

# ---------------------------------
# GOOGLE MAPS API
# ---------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ---------------------------------
# GOOGLE SIGN-IN
# ---------------------------------
# Web Client ID from Google Cloud Console (required for idToken generation)
GOOGLE_WEB_CLIENT_ID=

# ---------------------------------
# MONITORING & ANALYTICS
# ---------------------------------
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_FLIPPER=true
ENABLE_REACTOTRON=true

# ---------------------------------
# SECURITY FEATURES
# ---------------------------------
CERTIFICATE_PINNING_ENABLED=false
ROOT_DETECTION_ENABLED=false
DEBUG_DETECTION_ENABLED=false

# ---------------------------------
# FEATURE FLAGS
# ---------------------------------
FEATURE_BIOMETRIC_AUTH=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_LOCATION_SERVICES=true
FEATURE_OFFLINE_MODE=true
FEATURE_DARK_MODE=true

# ---------------------------------
# DEBUG & LOGGING
# ---------------------------------
LOG_LEVEL=debug
ENABLE_NETWORK_LOGGING=true
ENABLE_REDUX_LOGGING=true

# ---------------------------------
# CACHE & STORAGE
# ---------------------------------
CACHE_SIZE_LIMIT=50

# ---------------------------------
# GEOLOCATION DEFAULTS (Tunis, Tunisia)
# ---------------------------------
DEFAULT_LOCATION_LATITUDE=36.8065
DEFAULT_LOCATION_LONGITUDE=10.1815
LOCATION_ACCURACY_THRESHOLD=100


FEATURE_ONLINE_PAYMENT=false
  FLAT_DELIVERY_FEE=4.0
  DRIVER_DELIVERY_EARNINGS=3.0
  MAX_DELIVERY_KM=5
# ---------------------------------------------------------------------------
# Development-only session seeding
# ---------------------------------------------------------------------------
# Seeds a fixture session so the authenticated screens can be reached on an
# emulator without a real account. See src/dev/devSession.ts.
#
# Three gates must all hold before anything is written: a development build,
# this flag set to exactly "true", AND API_BASE_URL pointing at localhost.
# The last one means a fake token is never written while the app can reach a
# real backend, so leaving this on by mistake is inert.
#
# Never set this to true in .env.staging or .env.production - devSession.test.ts
# fails if you do.
ENABLE_DEV_AUTH=false
