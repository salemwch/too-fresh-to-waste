# ==================================
# TOO FRESH TO WASTE - MOBILE APP
# ==================================
# Template for environment configuration
# Copy to create: .env.development, .env.staging, .env.production
# ==================================

# ---------------------------------
# APP CONFIGURATION
# ---------------------------------
APP_NAME=Too Fresh To Waste
APP_VERSION=1.0.0
BUNDLE_IDENTIFIER=com.foodwaste.app
ENVIRONMENT=development

# ---------------------------------
# API CONFIGURATION
# ---------------------------------
API_BASE_URL=http://localhost:3000/api/v1
WEBSOCKET_URL=ws://localhost:3000
API_TIMEOUT=15000
API_RETRY_COUNT=3

# ---------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------
JWT_REFRESH_THRESHOLD=300000
SESSION_TIMEOUT=3600000
STORAGE_ENCRYPTION_KEY=your-encryption-key-here

# ---------------------------------
# FIREBASE CONFIGURATION
# ---------------------------------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abcdef

# ---------------------------------
# GOOGLE MAPS API
# ---------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ---------------------------------
# MONITORING & ANALYTICS
# ---------------------------------
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_FLIPPER=true
ENABLE_REACTOTRON=true

# ---------------------------------
# SECURITY FEATURES
# ---------------------------------
CERTIFICATE_PINNING_ENABLED=false
ROOT_DETECTION_ENABLED=false
DEBUG_DETECTION_ENABLED=false

# ---------------------------------
# FEATURE FLAGS
# ---------------------------------
FEATURE_BIOMETRIC_AUTH=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_LOCATION_SERVICES=true
FEATURE_OFFLINE_MODE=true
FEATURE_DARK_MODE=true

# ---------------------------------
# DEBUG & LOGGING
# ---------------------------------
LOG_LEVEL=debug
ENABLE_NETWORK_LOGGING=true
ENABLE_REDUX_LOGGING=true

# ---------------------------------
# CACHE & STORAGE
# ---------------------------------
CACHE_SIZE_LIMIT=50

# ---------------------------------
# GEOLOCATION DEFAULTS
# ---------------------------------
DEFAULT_LOCATION_LATITUDE=36.8065
DEFAULT_LOCATION_LONGITUDE=10.1815
LOCATION_ACCURACY_THRESHOLD=100