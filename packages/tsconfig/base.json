{
  "$schema": "https://json.schemastore.org/tsconfig",
  // ─────────────────────────────────────────────────────────────────
  // BASE — Strict TypeScript settings shared across every app/package.
  // Platform-specific settings (module, moduleResolution, jsx, lib,
  // target, outDir, paths) live in the per-preset files.
  // ─────────────────────────────────────────────────────────────────
  "compilerOptions": {
    // ── Interop ────────────────────────────────────────────────────
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // ── Decorators (NestJS / TypeORM — harmless on other targets) ──
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,

    // ── Emit helpers ───────────────────────────────────────────────
    "importHelpers": true,
    "preserveConstEnums": true,

    // ── Skip vendored types ────────────────────────────────────────
    "skipLibCheck": true,

    // ── Full strict mode + extra pedantic checks ───────────────────
    "strict": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
