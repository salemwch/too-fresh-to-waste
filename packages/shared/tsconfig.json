{
  // Internal shared library — extends @foodwaste/tsconfig/library preset.
  // CommonJS output, composite build, relaxed strict settings for cross-platform use.
  "extends": "@foodwaste/tsconfig/library",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "jsx": "react-native",
    "paths": {
      "@foodwaste/shared": ["./src"],
      "@foodwaste/shared/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage"]
}
