{
  "name": "@foodwaste/shared",
  "version": "1.0.0",
  "description": "Shared utilities, types, and configurations for Food Waste App",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix --cache",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:watch": "jest --watch",
    "clean": "rimraf dist node_modules",
    "spec:fetch": "node scripts/fetch-openapi-spec.mjs",
    "spec:generate": "openapi-typescript openapi.json -o src/types/generated/api.generated.ts",
    "generate": "pnpm spec:fetch && pnpm spec:generate",
    "security:check": "npx audit-ci --config audit-ci.json"
  },
  "dependencies": {
    "tslib": "2.8.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@foodwaste/tsconfig": "workspace:*",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "audit-ci": "^6.6.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
