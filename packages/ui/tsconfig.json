{
  // React UI component library — extends @foodwaste/tsconfig/ui-library preset.
  // ESNext + bundler resolution; consumers bundle from TS source.
  "extends": "@foodwaste/tsconfig/ui-library",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
